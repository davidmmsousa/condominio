# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Apenas servidor (API routes que usem admin client). Nunca no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password inicial ao criar conta Auth ao registar morador (mín. 6 caracteres). Se omitido, usa tomar2026.
# RESIDENT_DEFAULT_PASSWORD=tomar2026

# Opcional: NIF do condomínio no PDF do recibo (por defeito 901714925)
# RECEIPT_CONDOMINIUM_TAX_ID=901714925

# Opcional até configurares Gmail (ver docs/gmail-setup.md)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_SENDER=ruavincennescondominio@gmail.com
